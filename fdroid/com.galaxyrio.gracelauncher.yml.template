# Draft only. scripts/prepare-fdroid.ps1 fills the two public release identifiers.
# Resolve the remaining items in docs/FDROID.zh-CN.md before submitting.
Categories:
  - Launcher
  - System
License: GPL-3.0-only
AuthorName: Galaxy-rio
SourceCode: https://github.com/Galaxy-rio/GraceLauncher
IssueTracker: https://github.com/Galaxy-rio/GraceLauncher/issues
Translation: https://hosted.weblate.org/engage/grace_launcher/
Changelog: https://github.com/Galaxy-rio/GraceLauncher/blob/master/CHANGELOG.md

AutoName: Grace Launcher

RepoType: git
Repo: https://github.com/Galaxy-rio/GraceLauncher.git
Binaries: https://github.com/Galaxy-rio/GraceLauncher/releases/download/v%v/GraceLauncher_%v.apk

Builds:
  - versionName: 1.0.0
    versionCode: 1
    commit: '@RELEASE_COMMIT@'
    subdir: app
    sudo:
      - apt-get update
      - apt-get install -y openjdk-21-jdk-headless
    gradle:
      - yes

AllowedAPKSigningKeys: '@SIGNING_CERTIFICATE_SHA256@'

AutoUpdateMode: Version
UpdateCheckMode: Tags ^v[0-9]+\.[0-9]+\.[0-9]+$
CurrentVersion: 1.0.0
CurrentVersionCode: 1
